# ---- Base de donnees SQL Server ----
# Optionnel : si vous preferez passer une URL de connexion complete, utilisez DATABASE_URL.
DATABASE_URL=mssql+pyodbc://sa:your-db-password@localhost/RMA_Helpdesk?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
DB_SERVER=localhost
DB_NAME=RMA_Helpdesk
DB_USER=sa
DB_PASSWORD=your-db-password
DB_DRIVER=ODBC Driver 18 for SQL Server

# ---- Securite / JWT ----
SECRET_KEY=replace-with-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- Groq (chatbot IA) ----
GROQ_API_KEY=your-groq-api-key

# ---- Email SMTP ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-app-password

# Email qui recevra les nouveaux tickets
HELPDESK_TICKET_EMAIL=helpdesk@example.com

# ---- Frontend ----
FRONTEND_RESET_URL=http://localhost:3000/reset-password